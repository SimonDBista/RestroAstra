# ==============================================================================
# RestroAstra — Environment Configuration
# Tagline: One platform. Every restaurant operation.
# ==============================================================================

# Node Environment & Isolated Application Port
# (Using port 3005 to guarantee zero collision with original apps on 3000/3001)
NODE_ENV=production
PORT=3005

# ------------------------------------------------------------------------------
# Database Connection (Dedicated & Isolated Database)
# ------------------------------------------------------------------------------
# Option A: Standalone SQLite (Isolated file within RestroAstra workspace)
DATABASE_URL="file:./restroastra.db"

# Option B: Dedicated PostgreSQL (Recommended for production SaaS)
# Ensure you create a dedicated database and user on your PostgreSQL server:
#   CREATE DATABASE restroastra_prod;
#   CREATE USER restroastra_user WITH ENCRYPTED PASSWORD 'replace_with_secure_password';
#   GRANT ALL PRIVILEGES ON DATABASE restroastra_prod TO restroastra_user;
# DATABASE_URL="postgresql://restroastra_user:replace_with_secure_password@localhost:5432/restroastra_prod?schema=public"

# ------------------------------------------------------------------------------
# Authentication & JWT Secrets (Must be unique & random for RestroAstra)
# ------------------------------------------------------------------------------
JWT_SECRET="restroastra_jwt_secret_generate_unique_64_character_string_here"
ADMIN_JWT_SECRET="restroastra_admin_secret_generate_unique_64_character_string_here"

# ------------------------------------------------------------------------------
# Isolated Session & Cookie Names (Prevents browser cookie collisions)
# ------------------------------------------------------------------------------
AUTH_COOKIE_HOTEL="restroastra_hotel_token"
AUTH_COOKIE_ADMIN="restroastra_admin_token"

# ------------------------------------------------------------------------------
# Public Domain URL (Set to your configured new domain or subdomain)
# ------------------------------------------------------------------------------
# e.g., https://restroastra.com or https://app.restroastra.com
NEXT_PUBLIC_APP_URL="https://NEW_APP_DOMAIN"
